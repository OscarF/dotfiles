#!/usr/bin/env zsh

# Sync app settings between this machine and the dotfiles repo.
#
#   setup/app_settings export           Machine -> repo (run automatically by the watcher)
#   setup/app_settings import           Repo -> machine (e.g. on a new machine, or after git pull)
#   setup/app_settings install-watcher  Install a LaunchAgent that runs `export` on every change
#   setup/app_settings remove-watcher   Remove the LaunchAgent
#
# Exported changes show up in `git status`; commit them when you want to take them along.
#
# LinearMouse needs nothing here: its config is a stow symlink, so it writes into the repo.
# Rectangle: settings live in the com.knollsoft.Rectangle defaults domain. Rectangle
#   consumes (renames) its JSON import file, so a symlink can't work. Instead the domain
#   is exported to app-settings/com.knollsoft.Rectangle.plist, minus volatile keys.

set -e

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SETTINGS_DIR="$DOTFILES_DIR/app-settings"
PLISTBUDDY=/usr/libexec/PlistBuddy

RECTANGLE_DOMAIN="com.knollsoft.Rectangle"
RECTANGLE_PLIST="$SETTINGS_DIR/$RECTANGLE_DOMAIN.plist"
RECTANGLE_PREFS="$HOME/Library/Preferences/$RECTANGLE_DOMAIN.plist"

AGENT_LABEL="local.dotfiles.app-settings"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
AGENT_LOG="$HOME/Library/Logs/dotfiles-app-settings.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }

# Top-level keys of a plist file, one per line
plist_keys() {
    # -a: data values print raw bytes, which would make grep treat the output as binary
    "$PLISTBUDDY" -c "Print" "$1" | grep -aE '^    [^ ]' | sed -E 's/^    //; s/ = .*//'
}

# Keys that change on their own (window frames, update checks, versions) and would
# only produce noise in git. Matches against the key name.
is_volatile_rectangle_key() {
    case "$1" in
        SUEnableAutomaticChecks) return 1 ;;  # A real preference: keep
        NS*|SU*|lastVersion) return 0 ;;
        *) return 1 ;;
    esac
}

export_rectangle() {
    if ! defaults read "$RECTANGLE_DOMAIN" &>/dev/null; then
        log "Rectangle: no settings on this machine, skipping"
        return
    fi

    local tmp
    tmp="$(mktemp -t rectangle)"
    defaults export "$RECTANGLE_DOMAIN" "$tmp"

    local key
    plist_keys "$tmp" | while IFS= read -r key; do
        if is_volatile_rectangle_key "$key"; then
            plutil -remove "$key" "$tmp"
        fi
    done
    plutil -convert xml1 "$tmp"

    if [[ -f "$RECTANGLE_PLIST" ]] && cmp -s "$tmp" "$RECTANGLE_PLIST"; then
        rm -f "$tmp"
    else
        mv "$tmp" "$RECTANGLE_PLIST"
        log "Rectangle: exported to ${RECTANGLE_PLIST#"$DOTFILES_DIR"/}"
    fi
}

import_rectangle() {
    if [[ ! -f "$RECTANGLE_PLIST" ]]; then
        log "Rectangle: ${RECTANGLE_PLIST#"$DOTFILES_DIR"/} not found, skipping"
        return
    fi

    local was_running=false
    if pgrep -xq Rectangle; then
        was_running=true
        osascript -e 'quit app "Rectangle"'
        while pgrep -xq Rectangle; do sleep 0.2; done
    fi

    # Merge into the current settings so machine-local keys (window frames, update
    # state) are preserved: drop keys the repo defines, then merge the repo's in.
    local tmp key
    tmp="$(mktemp -t rectangle)"
    if defaults read "$RECTANGLE_DOMAIN" &>/dev/null; then
        defaults export "$RECTANGLE_DOMAIN" "$tmp"
        plist_keys "$RECTANGLE_PLIST" | while IFS= read -r key; do
            plutil -remove "$key" "$tmp" 2>/dev/null || true
        done
        "$PLISTBUDDY" -c "Merge $RECTANGLE_PLIST" "$tmp" >/dev/null
    else
        cp "$RECTANGLE_PLIST" "$tmp"
    fi
    defaults import "$RECTANGLE_DOMAIN" "$tmp"
    rm -f "$tmp"
    log "Rectangle: imported settings from repo"

    if $was_running; then
        open -a Rectangle
    fi
}

install_watcher() {
    mkdir -p "$(dirname "$AGENT_PLIST")" "$(dirname "$AGENT_LOG")"
    cat > "$AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by $DOTFILES_DIR/setup/app_settings install-watcher -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$AGENT_LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>$DOTFILES_DIR/setup/app_settings</string>
        <string>export</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>$RECTANGLE_PREFS</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$AGENT_LOG</string>
    <key>StandardErrorPath</key>
    <string>$AGENT_LOG</string>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST"
    echo "Watcher installed: $AGENT_PLIST (log: $AGENT_LOG)"
}

remove_watcher() {
    launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null || true
    rm -f "$AGENT_PLIST"
    echo "Watcher removed"
}

case "${1:-}" in
    export)
        export_rectangle
        ;;
    import)
        import_rectangle
        ;;
    install-watcher)
        install_watcher
        ;;
    remove-watcher)
        remove_watcher
        ;;
    *)
        sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
